{
  "name": "@weebo/operator-docs",
  "version": "0.18.2",
  "description": "Shared format of the weebo operators' Fumadocs/Next documentation sites: CRD reference generator, manifest builder, theme, layout and routes.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/batleforc/weebo-operator-kit.git",
    "directory": "packages/operator-docs"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "bin": {
    "weebo-crd-docs": "./bin/weebo-crd-docs.mjs"
  },
  "exports": {
    "./crd-form": "./src/crd-form/index.ts",
    "./site": "./src/site/index.ts",
    "./config": "./src/site/config.ts",
    "./routes": "./src/site/routes.tsx",
    "./diagram-style": "./src/diagram-style.ts",
    "./crd-docs": "./src/crd-docs/generate.mjs",
    "./next": "./next.mjs",
    "./css/*": "./css/*",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "css",
    "src",
    "next.mjs",
    "README.md"
  ],
  "scripts": {
    "check": "tsc --noEmit && node --test 'test/*.test.mjs'"
  },
  "dependencies": {
    "js-yaml": "^5.2.1"
  },
  "peerDependencies": {
    "@types/mdx": "^2.0.14",
    "fumadocs-core": "^16.16.2",
    "fumadocs-mdx": "^15.4.6",
    "fumadocs-ui": "^16.16.2",
    "lucide-react": "^1.24.0",
    "next": "^16.4.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shiki": "^4.3.1"
  },
  "devDependencies": {
    "@mdx-js/mdx": "3.1.1",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "fumadocs-core": "16.16.2",
    "fumadocs-mdx": "15.4.6",
    "fumadocs-ui": "16.16.2",
    "lucide-react": "^1.24.0",
    "next": "16.4.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remark-gfm": "4.0.1",
    "shiki": "^4.3.1",
    "typescript": "^6.0.3"
  }
}
